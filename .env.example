# LearnHub Environment Configuration
# Reference: edtech_platform_srad.pdf

# Root Domain Configuration (for multi-tenant subdomain middleware)
# In local dev: localhost:8000
# In production: learnhub.me or yourplatform.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost:8000
NEXT_PUBLIC_APP_URL=https://instruct-hub.vercel.app

# Supabase (PostgreSQL with Row Level Security)
NEXT_SUPABASE_URL=https://your-project.supabase.co
NEXT_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LearnHub-owned Mux account credentials (server-only; configure in Vercel too).
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_SIGNING_KEY_ID=your-mux-signing-key-id
MUX_SIGNING_KEY_PRIVATE_KEY=your-base64-encoded-mux-signing-private-key

# Legacy Cloudflare videos remain playable.
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=customer-m033p5x0q6nfd92u.cloudflarestream.com

# Payment Rails (Scale) - Paymob / Tap Payments
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_INTEGRATION_ID=your-paymob-integration-id
